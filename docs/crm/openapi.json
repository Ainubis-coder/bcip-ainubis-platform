      "parameters": [{ "$ref": "#/components/parameters/IdParam" }, { "$ref": "#/components/parameters/IdempotencyKeyHeader" }],
      "post": { "summary": "Activate contract and advance Opportunity to WON", "tags": ["Contracts"], "responses": { "200": { "$ref": "#/components/responses/SingleContractResponse" } } }
