{
  "openapi": "3.0.3",
  "info": {
    "title": "BCIP CRM & Sales Engine REST API",
    "description": "Enterprise multi-tenant REST API for the Body Corporate Intelligence Platform (BCIP) CRM domain. Manages Leads, Contacts, Organisations, Scheme Prospects, Opportunities, Activities, Tasks, Campaigns, Proposals, and Contracts.",
    "version": "1.0.0",
    "contact": {
      "name": "BCIP Platform Engineering",
      "email": "engineering@bcip.platform"
    }
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Production & Staging API v1 Gateway"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/organisations": {
      "get": {
        "summary": "List organisations with pagination, search, and filtering",
        "tags": ["Organisations"],
        "parameters": [
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/PageSizeParam" },
          { "$ref": "#/components/parameters/SortByParam" },
          { "$ref": "#/components/parameters/SortOrderParam" },
          { "$ref": "#/components/parameters/SearchParam" },
          { "name": "status", "in": "query", "schema": { "$ref": "#/components/schemas/OrganisationStatus" } },
          { "name": "organisationType", "in": "query", "schema": { "$ref": "#/components/schemas/OrganisationType" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/PaginatedOrganisationsResponse" },
          "401": { "$ref": "#/components/responses/UnauthorizedError" },
          "403": { "$ref": "#/components/responses/ForbiddenError" }
        }
      },
      "post": {
        "summary": "Create a new organisation",
        "tags": ["Organisations"],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKeyHeader" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateOrganisationDto" } } }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/SingleOrganisationResponse" },
          "400": { "$ref": "#/components/responses/BadRequestError" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/organisations/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/IdParam" }],
      "get": {
        "summary": "Retrieve an organisation by ID",
        "tags": ["Organisations"],
        "responses": {
          "200": { "$ref": "#/components/responses/SingleOrganisationResponse" },
          "404": { "$ref": "#/components/responses/NotFoundError" }
        }
      },
      "patch": {
        "summary": "Update organisation attributes",
        "tags": ["Organisations"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateOrganisationDto" } } }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/SingleOrganisationResponse" },
          "404": { "$ref": "#/components/responses/NotFoundError" }
        }
      },
      "delete": {
        "summary": "Soft-delete an organisation",
        "tags": ["Organisations"],
        "responses": {
          "200": { "$ref": "#/components/responses/DeleteResponse" },
          "404": { "$ref": "#/components/responses/NotFoundError" }
        }
      }
    },
    "/organisations/{id}/contacts": {
      "parameters": [{ "$ref": "#/components/parameters/IdParam" }],
      "get": {
        "summary": "List all contacts affiliated with this organisation",
        "tags": ["Organisations"],
        "responses": {
          "200": { "$ref": "#/components/responses/ContactsListResponse" },
          "404": { "$ref": "#/components/responses/NotFoundError" }
        }
      }
    },
    "/organisations/{id}/opportunities": {
      "parameters": [{ "$ref": "#/components/parameters/IdParam" }],
      "get": {
        "summary": "List all sales opportunities for this organisation",
        "tags": ["Organisations"],
        "responses": {
          "200": { "$ref": "#/components/responses/OpportunitiesListResponse" },
          "404": { "$ref": "#/components/responses/NotFoundError" }
        }
      }
    },
    "/organisations/{id}/scheme-prospects": {
      "parameters": [{ "$ref": "#/components/parameters/IdParam" }],
      "get": {
        "summary": "List scheme prospects associated with this organisation",
        "tags": ["Organisations"],
        "responses": {
          "200": { "$ref": "#/components/responses/SchemeProspectsListResponse" },
          "404": { "$ref": "#/components/responses/NotFoundError" }
        }
      }
    },
    "/contacts": {
      "get": {
        "summary": "List contacts with pagination and search",
        "tags": ["Contacts"],
        "parameters": [
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/PageSizeParam" },
          { "$ref": "#/components/parameters/SearchParam" },
          { "name": "organisationId", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "$ref": "#/components/schemas/ContactStatus" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/PaginatedContactsResponse" }
        }
      },
      "post": {
        "summary": "Create a new contact",
        "tags": ["Contacts"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateContactDto" } } }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/SingleContactResponse" }
        }
      }
    },
    "/contacts/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/IdParam" }],
      "get": {
        "summary": "Get contact by ID",
        "tags": ["Contacts"],
        "responses": { "200": { "$ref": "#/components/responses/SingleContactResponse" }, "404": { "$ref": "#/components/responses/NotFoundError" } }
      },
      "patch": {
        "summary": "Update contact",
        "tags": ["Contacts"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateContactDto" } } }
        },
        "responses": { "200": { "$ref": "#/components/responses/SingleContactResponse" } }
      },
      "delete": {
        "summary": "Soft delete contact",
        "tags": ["Contacts"],
        "responses": { "200": { "$ref": "#/components/responses/DeleteResponse" } }
      }
    },
    "/leads": {
      "get": {
        "summary": "List leads with pagination and qualification filters",
        "tags": ["Leads"],
        "parameters": [
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/PageSizeParam" },
          { "$ref": "#/components/parameters/SearchParam" },
          { "name": "status", "in": "query", "schema": { "$ref": "#/components/schemas/LeadStatus" } },
          { "name": "qualificationStatus", "in": "query", "schema": { "$ref": "#/components/schemas/QualificationStatus" } },
          { "name": "campaignId", "in": "query", "schema": { "type": "string" } },
          { "name": "leadOwnerId", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/PaginatedLeadsResponse" }
        }
      },
      "post": {
        "summary": "Capture a new lead",
        "tags": ["Leads"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateLeadDto" } } }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/SingleLeadResponse" }
        }
      }
    },
    "/leads/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/IdParam" }],
      "get": {
        "summary": "Get lead details",
        "tags": ["Leads"],
        "responses": { "200": { "$ref": "#/components/responses/SingleLeadResponse" }, "404": { "$ref": "#/components/responses/NotFoundError" } }
      },
      "patch": {
        "summary": "Update lead details",
        "tags": ["Leads"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateLeadDto" } } }
        },
        "responses": { "200": { "$ref": "#/components/responses/SingleLeadResponse" } }
      },
      "delete": {
        "summary": "Soft delete lead",
        "tags": ["Leads"],
        "responses": { "200": { "$ref": "#/components/responses/DeleteResponse" } }
      }
    },
    "/leads/{id}/convert": {
      "parameters": [{ "$ref": "#/components/parameters/IdParam" }, { "$ref": "#/components/parameters/IdempotencyKeyHeader" }],
      "post": {
        "summary": "Atomically convert a lead into an Organisation, Contact, Scheme Prospect, and Opportunity",
        "tags": ["Leads"],
        "requestBody": {
          "required": false,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConvertLeadDto" } } }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/ConvertLeadResponse" },
          "409": { "$ref": "#/components/responses/ConflictError" }
        }
      }
    },
    "/scheme-prospects": {
      "get": {
        "summary": "List scheme prospects",
        "tags": ["Scheme Prospects"],
        "parameters": [
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/PageSizeParam" },
          { "$ref": "#/components/parameters/SearchParam" },
          { "name": "organisationId", "in": "query", "schema": { "type": "string" } },
          { "name": "leadId", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "$ref": "#/components/responses/PaginatedSchemeProspectsResponse" } }
      },
      "post": {
        "summary": "Create scheme prospect",
        "tags": ["Scheme Prospects"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateSchemeProspectDto" } } }
        },
        "responses": { "201": { "$ref": "#/components/responses/SingleSchemeProspectResponse" } }
      }
    },
    "/scheme-prospects/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/IdParam" }],
      "get": {
        "summary": "Get scheme prospect by ID",
        "tags": ["Scheme Prospects"],
        "responses": { "200": { "$ref": "#/components/responses/SingleSchemeProspectResponse" } }
      },
      "patch": {
        "summary": "Update scheme prospect",
        "tags": ["Scheme Prospects"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateSchemeProspectDto" } } } },
        "responses": { "200": { "$ref": "#/components/responses/SingleSchemeProspectResponse" } }
      },
      "delete": {
        "summary": "Soft delete scheme prospect",
        "tags": ["Scheme Prospects"],
        "responses": { "200": { "$ref": "#/components/responses/DeleteResponse" } }
      }
    },
    "/opportunities": {
      "get": {
        "summary": "List opportunities",
        "tags": ["Opportunities"],
        "parameters": [
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/PageSizeParam" },
          { "$ref": "#/components/parameters/SearchParam" },
          { "name": "stage", "in": "query", "schema": { "$ref": "#/components/schemas/OpportunityStage" } },
          { "name": "organisationId", "in": "query", "schema": { "type": "string" } },
          { "name": "ownerUserId", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "$ref": "#/components/responses/PaginatedOpportunitiesResponse" } }
      },
      "post": {
        "summary": "Create sales opportunity",
        "tags": ["Opportunities"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateOpportunityDto" } } }
        },
        "responses": { "201": { "$ref": "#/components/responses/SingleOpportunityResponse" } }
      }
    },
    "/opportunities/pipeline": {
      "get": {
        "summary": "Retrieve pipeline-oriented aggregation grouped by stages",
        "tags": ["Opportunities"],
        "parameters": [
          { "name": "stage", "in": "query", "schema": { "$ref": "#/components/schemas/OpportunityStage" } },
          { "name": "owner", "in": "query", "schema": { "type": "string" } },
          { "name": "fromDate", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "toDate", "in": "query", "schema": { "type": "string", "format": "date-time" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/PipelineSummaryResponse" }
        }
      }
    },
    "/opportunities/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/IdParam" }],
      "get": {
        "summary": "Get opportunity details",
        "tags": ["Opportunities"],
        "responses": { "200": { "$ref": "#/components/responses/SingleOpportunityResponse" } }
      },
      "patch": {
        "summary": "Update opportunity details",
        "tags": ["Opportunities"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateOpportunityDto" } } } },
        "responses": { "200": { "$ref": "#/components/responses/SingleOpportunityResponse" } }
      },
      "delete": {
        "summary": "Soft delete opportunity",
        "tags": ["Opportunities"],
        "responses": { "200": { "$ref": "#/components/responses/DeleteResponse" } }
      }
    },
    "/opportunities/{id}/stage": {
      "parameters": [{ "$ref": "#/components/parameters/IdParam" }, { "$ref": "#/components/parameters/IdempotencyKeyHeader" }],
      "post": {
        "summary": "Transition opportunity to a new pipeline stage and append to stage history",
        "tags": ["Opportunities"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StageTransitionDto" } } }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/StageTransitionResponse" }
        }
      }
    },
    "/opportunities/{id}/history": {
      "parameters": [{ "$ref": "#/components/parameters/IdParam" }],
      "get": {
        "summary": "Retrieve complete stage velocity and transition audit history",
        "tags": ["Opportunities"],
        "responses": {
          "200": { "$ref": "#/components/responses/OpportunityStageHistoryListResponse" }
        }
      }
    },
    "/activities": {
      "get": {
        "summary": "List CRM activities",
        "tags": ["Activities"],
        "parameters": [
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/PageSizeParam" },
          { "name": "activityType", "in": "query", "schema": { "$ref": "#/components/schemas/ActivityType" } },
          { "name": "leadId", "in": "query", "schema": { "type": "string" } },
          { "name": "opportunityId", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "$ref": "#/components/responses/PaginatedActivitiesResponse" } }
      },
      "post": {
        "summary": "Log a new activity",
        "tags": ["Activities"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateActivityDto" } } } },
        "responses": { "201": { "$ref": "#/components/responses/SingleActivityResponse" } }
      }
    },
    "/activities/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/IdParam" }],
      "get": { "summary": "Get activity by ID", "tags": ["Activities"], "responses": { "200": { "$ref": "#/components/responses/SingleActivityResponse" } } },
      "patch": { "summary": "Update activity", "tags": ["Activities"], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateActivityDto" } } } }, "responses": { "200": { "$ref": "#/components/responses/SingleActivityResponse" } } },
      "delete": { "summary": "Soft delete activity", "tags": ["Activities"], "responses": { "200": { "$ref": "#/components/responses/DeleteResponse" } } }
    },
    "/tasks": {
      "get": {
        "summary": "List tasks",
        "tags": ["Tasks"],
        "parameters": [
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/PageSizeParam" },
          { "name": "status", "in": "query", "schema": { "$ref": "#/components/schemas/TaskStatus" } },
          { "name": "priority", "in": "query", "schema": { "$ref": "#/components/schemas/TaskPriority" } },
          { "name": "assignedTo", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "$ref": "#/components/responses/PaginatedTasksResponse" } }
      },
      "post": {
        "summary": "Create CRM task",
        "tags": ["Tasks"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateTaskDto" } } } },
        "responses": { "201": { "$ref": "#/components/responses/SingleTaskResponse" } }
      }
    },
    "/tasks/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/IdParam" }],
      "get": { "summary": "Get task by ID", "tags": ["Tasks"], "responses": { "200": { "$ref": "#/components/responses/SingleTaskResponse" } } },
      "patch": { "summary": "Update task", "tags": ["Tasks"], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateTaskDto" } } } }, "responses": { "200": { "$ref": "#/components/responses/SingleTaskResponse" } } },
      "delete": { "summary": "Soft delete task", "tags": ["Tasks"], "responses": { "200": { "$ref": "#/components/responses/DeleteResponse" } } }
    },
    "/tasks/{id}/complete": {
      "parameters": [{ "$ref": "#/components/parameters/IdParam" }, { "$ref": "#/components/parameters/IdempotencyKeyHeader" }],
      "post": {
        "summary": "Mark task as COMPLETED",
        "tags": ["Tasks"],
        "responses": { "200": { "$ref": "#/components/responses/SingleTaskResponse" } }
      }
    },
    "/campaigns": {
      "get": {
        "summary": "List campaigns",
        "tags": ["Campaigns"],
        "parameters": [
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/PageSizeParam" },
          { "name": "status", "in": "query", "schema": { "$ref": "#/components/schemas/CampaignStatus" } }
        ],
        "responses": { "200": { "$ref": "#/components/responses/PaginatedCampaignsResponse" } }
      },
      "post": {
        "summary": "Create marketing/sales campaign",
        "tags": ["Campaigns"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateCampaignDto" } } } },
        "responses": { "201": { "$ref": "#/components/responses/SingleCampaignResponse" } }
      }
    },
    "/campaigns/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/IdParam" }],
      "get": { "summary": "Get campaign by ID", "tags": ["Campaigns"], "responses": { "200": { "$ref": "#/components/responses/SingleCampaignResponse" } } },
      "patch": { "summary": "Update campaign", "tags": ["Campaigns"], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateCampaignDto" } } } }, "responses": { "200": { "$ref": "#/components/responses/SingleCampaignResponse" } } },
      "delete": { "summary": "Soft delete campaign", "tags": ["Campaigns"], "responses": { "200": { "$ref": "#/components/responses/DeleteResponse" } } }
    },
    "/proposals": {
      "get": {
        "summary": "List commercial proposals",
        "tags": ["Proposals"],
        "parameters": [
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/PageSizeParam" },
          { "name": "status", "in": "query", "schema": { "$ref": "#/components/schemas/ProposalStatus" } },
          { "name": "opportunityId", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "$ref": "#/components/responses/PaginatedProposalsResponse" } }
      },
      "post": {
        "summary": "Generate a new proposal with decimal currency calculation",
        "tags": ["Proposals"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateProposalDto" } } } },
        "responses": { "201": { "$ref": "#/components/responses/SingleProposalResponse" } }
      }
    },
    "/proposals/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/IdParam" }],
      "get": { "summary": "Get proposal details", "tags": ["Proposals"], "responses": { "200": { "$ref": "#/components/responses/SingleProposalResponse" } } },
      "patch": { "summary": "Update proposal", "tags": ["Proposals"], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateProposalDto" } } } }, "responses": { "200": { "$ref": "#/components/responses/SingleProposalResponse" } } },
      "delete": { "summary": "Soft delete proposal", "tags": ["Proposals"], "responses": { "200": { "$ref": "#/components/responses/DeleteResponse" } } }
    },
    "/proposals/{id}/send": {
      "parameters": [{ "$ref": "#/components/parameters/IdParam" }, { "$ref": "#/components/parameters/IdempotencyKeyHeader" }],
      "post": { "summary": "Issue and send proposal to client", "tags": ["Proposals"], "responses": { "200": { "$ref": "#/components/responses/SingleProposalResponse" } } }
    },
    "/proposals/{id}/accept": {
      "parameters": [{ "$ref": "#/components/parameters/IdParam" }, { "$ref": "#/components/parameters/IdempotencyKeyHeader" }],
      "post": { "summary": "Record client commercial acceptance", "tags": ["Proposals"], "responses": { "200": { "$ref": "#/components/responses/SingleProposalResponse" } } }
    },
    "/proposals/{id}/reject": {
      "parameters": [{ "$ref": "#/components/parameters/IdParam" }],
      "post": { "summary": "Record client decline/rejection", "tags": ["Proposals"], "responses": { "200": { "$ref": "#/components/responses/SingleProposalResponse" } } }
    },
    "/contracts": {
      "get": {
        "summary": "List customer contracts",
        "tags": ["Contracts"],
        "parameters": [
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/PageSizeParam" },
          { "name": "status", "in": "query", "schema": { "$ref": "#/components/schemas/ContractStatus" } },
          { "name": "opportunityId", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "$ref": "#/components/responses/PaginatedContractsResponse" } }
      },
      "post": {
        "summary": "Create Master Services Agreement / Contract",
        "tags": ["Contracts"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateContractDto" } } } },
        "responses": { "201": { "$ref": "#/components/responses/SingleContractResponse" } }
      }
    },
    "/contracts/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/IdParam" }],
      "get": { "summary": "Get contract by ID", "tags": ["Contracts"], "responses": { "200": { "$ref": "#/components/responses/SingleContractResponse" } } },
      "patch": { "summary": "Update contract details", "tags": ["Contracts"], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateContractDto" } } } }, "responses": { "200": { "$ref": "#/components/responses/SingleContractResponse" } } },
      "delete": { "summary": "Soft delete contract", "tags": ["Contracts"], "responses": { "200": { "$ref": "#/components/responses/DeleteResponse" } } }
    },
    "/contracts/{id}/sign": {
      "parameters": [{ "$ref": "#/components/parameters/IdParam" }, { "$ref": "#/components/parameters/IdempotencyKeyHeader" }],
      "post": { "summary": "Execute and record signatures", "tags": ["Contracts"], "responses": { "200": { "$ref": "#/components/responses/SingleContractResponse" } } }
    },
