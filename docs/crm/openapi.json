      "parameters": [{ "$ref": "#/components/parameters/IdParam" }],
      "post": { "summary": "Terminate active contract", "tags": ["Contracts"], "responses": { "200": { "$ref": "#/components/responses/SingleContractResponse" } } }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
