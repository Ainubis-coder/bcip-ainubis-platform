# ==============================================================================
# BCIP — BODY CORPORATE INTELLIGENCE PLATFORM
# PHASE 1 — FOUNDATION
# DEVELOPMENT ENVIRONMENT
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------------------
APP_NAME="BCIP — Body Corporate Intelligence Platform"
APP_ENV=development
APP_VERSION=0.1.0
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# NETWORKING
# ------------------------------------------------------------------------------
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REQUEST_ID_HEADER=x-request-id

# ------------------------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://bcip_user:bcip_secure_password@localhost:5432/bcip_platform?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bcip_platform
DB_USER=bcip_user
DB_PASSWORD=bcip_secure_password
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# REDIS
# ------------------------------------------------------------------------------
REDIS_URL=redis://:redis_secure_password@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password
REDIS_DB=0

# ------------------------------------------------------------------------------
# OBJECT STORAGE
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=bcip-documents
STORAGE_REGION=eu-west-1
STORAGE_ACCESS_KEY=minio_access_key
STORAGE_SECRET_KEY=minio_secret_key
STORAGE_USE_SSL=false

# ------------------------------------------------------------------------------
# AUTHENTICATION FOUNDATION
# ------------------------------------------------------------------------------
AUTH_JWT_SECRET=development_jwt_secret_replace_before_production_32_chars_minimum
AUTH_JWT_EXPIRES_IN=1h
AUTH_REFRESH_TOKEN_SECRET=development_refresh_secret_replace_before_production_32_chars_minimum
AUTH_REFRESH_TOKEN_EXPIRES_IN=7d
AUTH_ISSUER=bcip.ainubis.platform
AUTH_AUDIENCE=bcip-api

# ------------------------------------------------------------------------------
# AINUBIS / AI FOUNDATION
# ------------------------------------------------------------------------------
ENABLE_AI=false
ENABLE_AINUBIS=false

AI_PROVIDER_DEFAULT=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096
AI_AUDIT_ENABLED=true
AI_GUARDRAILS_ENABLED=true

# ------------------------------------------------------------------------------
# WORKER
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=5
WORKER_JOB_TIMEOUT_MS=30000
WORKER_RETRY_LIMIT=3

# ------------------------------------------------------------------------------
# DEVELOPMENT
# ------------------------------------------------------------------------------
DEMO_MODE=true
